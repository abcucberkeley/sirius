#!/bin/bash
# Fake sinfo: `sinfo -h -o '%P|%a|%l|%D|%t|%G|%c|%m'` as a cluster like fiona
# answers it (one line per partition and node state). $FAKE_SINFO_FILE, when
# set, is printed instead; $FAKE_SINFO_FAIL=1 (or a file sinfo.fail in
# $FAKE_SLURM_DIR, for a session already open) fails as a down slurmctld does.
set -u
[ -n "${FAKE_SLURM_DIR:-}" ] && printf '%s\n' "$*" > "$FAKE_SLURM_DIR/sinfo.args"
if [ "${FAKE_SINFO_FAIL:-0}" = 1 ] || [ -f "${FAKE_SLURM_DIR:-/nonexistent}/sinfo.fail" ]; then
    echo "slurm_load_partitions: Unable to contact slurm controller (connect failure)" >&2
    exit 1
fi
if [ -n "${FAKE_SINFO_FILE:-}" ]; then cat "$FAKE_SINFO_FILE"; exit 0; fi
cat <<'OUT'
cpu*|up|7-00:00:00|6|idle|(null)|64|257000
cpu*|up|7-00:00:00|4|alloc|(null)|64|257000
abc_a100|up|3-00:00:00|2|idle|gpu:a100:1(S:0)|32|500000
abc_a100|up|3-00:00:00|1|mix|gpu:a100:1(S:0)|32|500000
abc_a100|up|3-00:00:00|1|drain*|gpu:a100:1(S:0)|32|500000
dgx|up|1-00:00:00|1|mix|gpu:a100:8(S:0-1)|256|1000000
lab_h100|up|2-00:00:00|2|alloc|gpu:h100:4(S:0,1)|96|750000
OUT
