#!/bin/bash
# Fake sbatch for tests/test_app_cluster.cpp (through tests/tools/fake_ssh.py):
# no Slurm is involved. A job is files in $FAKE_SLURM_DIR: <id>.args (the
# command line), <id>.umask, <id>.pending (how many squeue polls it stays
# PENDING), <id>.state (RUNNING, then CANCELLED by scancel), and its --output
# log. SIRIUS's job only holds the allocation (sbatch --wrap: it sleeps), so
# nothing runs here: its steps are srun's (fake_slurm/srun), and the job is
# marked <id>.holder (squeue then looks at no process of its own). Prints the
# job id, like --parsable. A file sbatch.fail in $FAKE_SLURM_DIR refuses the
# job once its command line is recorded.
set -u
dir="${FAKE_SLURM_DIR:?FAKE_SLURM_DIR is not set}"
out="slurm-%j.out"
for a in "$@"; do
    case "$a" in
        --output=*) out="${a#--output=}" ;;
    esac
done
id=$(cat "$dir/next" 2>/dev/null || echo 4711)
echo $((id + 1)) > "$dir/next"
log="${out//%j/$id}"
printf '%s\n' "$*" > "$dir/$id.args"
umask > "$dir/$id.umask"
if [ -f "$dir/sbatch.fail" ]; then echo "sbatch: error: Batch job submission failed: refused by the test" >&2; exit 1; fi
echo "${FAKE_SLURM_PENDING_POLLS:-0}" > "$dir/$id.pending"
echo "sirius: job $id holds ${FAKE_SLURM_NODE:-fakenode} for SIRIUS's worker" > "$log"
touch "$dir/$id.holder"
echo RUNNING > "$dir/$id.state"
echo "$id"
