<!DOCTYPE RCC><RCC version="1.0">
<qresource prefix="/fonts">
    <file>fonts/Archivo-Regular.ttf</file>
    <file>fonts/Archivo-SemiBold.ttf</file>
    <file>fonts/Archivo-Bold.ttf</file>
    <file>fonts/Archivo-ExtraBold.ttf</file>
    <file>fonts/OFL.txt</file>
</qresource>
<qresource prefix="/icons">
    <file alias="chevron-down.svg">icons/chevron-down.svg</file>
    <file alias="app/sirius-app-16.png">icons/app/sirius-app-16.png</file>
    <file alias="app/sirius-app-24.png">icons/app/sirius-app-24.png</file>
    <file alias="app/sirius-app-32.png">icons/app/sirius-app-32.png</file>
    <file alias="app/sirius-app-48.png">icons/app/sirius-app-48.png</file>
    <file alias="app/sirius-app-64.png">icons/app/sirius-app-64.png</file>
    <file alias="app/sirius-app-128.png">icons/app/sirius-app-128.png</file>
    <file alias="app/sirius-app-256.png">icons/app/sirius-app-256.png</file>
</qresource>
</RCC>
