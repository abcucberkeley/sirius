<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded by the linker (app/CMakeLists.txt). activeCodePage makes the
     narrow Win32 APIs (CreateFileA, fopen, std::filesystem::path(std::string))
     read their char* arguments as UTF-8, which is what the application hands
     them: QString::toUtf8 everywhere a path leaves the Qt layer. Without it
     a dataset under a folder with an accent in its name cannot be opened. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
